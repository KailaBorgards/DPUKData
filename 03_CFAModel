## Diabetes, Obesity, Vision, Alcohol and Hearing only one indicator so no latent variable necessary

### Education
education <- df_cfa %>%
  select(EDUCnew, NACCEDULVLnew)

## FA
# Run factor analysis with 1 factor for Education and varimax rotation
edu_result <- fa(education, nfactors = 1, rotate = "varimax", fm = "ml")

# Print factor loadings
print(edu_result$loadings, cutoff = 0.3)
mean(edu_result$communality) #good

#Export to Table
edu_loadings_df <- as.data.frame(edu_result$scores)
edu_loadings_df$EDUCATION <- edu_loadings_df$ML1

