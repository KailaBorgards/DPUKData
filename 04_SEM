for (model_name in names(models)) {
  
  fit <- models[[model_name]]
  
  ####################################
  # TABLE 1: Parameter estimates
  ####################################
  
  parameter_table <- parameterEstimates(
    fit, standardized = TRUE
  ) %>%
    filter(op %in% c("~", ":=", "~~")) %>%
    mutate(Significance = case_when(
      pvalue < 0.001 ~ "***",
      pvalue < 0.01 ~ "**",
      pvalue < 0.05 ~ "*",
      TRUE ~ ""
    )) %>%
    select(
      Predictor = lhs,
      Relationship = op,
      Outcome = rhs,
      Estimate = est,
      'Std. Est.' = std.all,
      SE = se,
      z = z,
      'p-value' = pvalue,
      Significance
    )
  
  table1 <- kable(
    parameter_table,
    format = "html",
    digits = 3,
    caption = paste(model_name, "- SEM Parameter Estimates")
  ) %>%
    kable_styling(
      bootstrap_options = c("striped", "hover", "condensed"),
      full_width = FALSE,
      position = "center"
    )
  
  ####################################
  # TABLE 2: Model fit indices
  ####################################
  
  fit_table <- data.frame(
    Measure = c(
      "Chi-square",
      "Degrees of Freedom",
      "p-value",
      "CFI (robust)",
      "TLI (robust)",
      "SRMR",
      "RMSEA (robust)",
      "BIC"
    ),
    Value = round(
      fitMeasures(
        fit,
        c("chisq", "df", "pvalue",
          "cfi.robust", "tli.robust",
          "srmr", "rmsea.robust", "bic")
      ),
      3
    )
  )
  
  table2 <- kable(
    fit_table,
    format = "html",
    caption = paste(model_name, "- SEM Model Fit Indices")
  ) %>%
    kable_styling(
      bootstrap_options = c("striped", "hover", "condensed"),
      full_width = FALSE,
      position = "center"
    )
  
  ####################################
  # 3. DISPLAY BOTH TABLES
  ####################################
  
  print(table1)
  print(table2)
}



