############################################################################################################################
######################################################### EDUCATION ########################################################
############################################################################################################################


Edu_Model <- '
  ################################
  # 1. Measurement models
  ################################

  cognition =~ DECCLCOG + NACCMOCAnew + DEMENTED


  ################################
  # 2. Paths from lifestyle
  #    to the six mediators
  ################################

  CEREBRUMTCV ~ a1*EDUCnew + NACCAGE + NACCSEX
  GM ~ a2*EDUCnew + NACCAGE + NACCSEX
  HIPPOCAMPUS ~ a3*EDUCnew + NACCAGE + NACCSEX
  WMH ~ a4*EDUCnew + NACCAGE + NACCSEX
  CEREBRALWHITEMATTER ~ a5*EDUCnew + NACCAGE + NACCSEX
  
  CEREBRUMTCV ~~ GM
  CEREBRUMTCV ~~ CEREBRALWHITEMATTER
  GM ~~ CEREBRALWHITEMATTER
  GM ~~ HIPPOCAMPUS
  HIPPOCAMPUS ~~ CEREBRALWHITEMATTER
  HIPPOCAMPUS ~~ CEREBRUMTCV
  
  ################################
  # 3. Paths to cognition
  ################################

  cognition ~ c_prime*EDUCnew +
              b1*CEREBRUMTCV + b2*GM +
              b3*HIPPOCAMPUS + b4*WMH +
              b5*CEREBRALWHITEMATTER +
              NACCAGE + NACCSEX


  ################################
  # 4. Indirect effects
  ################################

  ind_TCV := a1*b1
  ind_GM := a2*b2
  ind_HIP := a3*b3
  ind_WMH := a4*b4
  ind_TWM := a5*b5


  ################################
  # 5. Total indirect effect
  ################################

  total_indirect := ind_TCV + ind_GM +
                    ind_HIP + ind_WMH +
                    ind_TWM


  ################################
  # 6. Total effect
  ################################

  total_effect := c_prime + total_indirect

'

fit_edu <- cfa(Edu_Model, data = data_merged_scaled, missing = "fiml", verbose = T, optim.method = "BFGS")
summary(fit_edu, fit.measures = T, standardized = T)

### Steps taken to optimize model
# 1) Scale data
# 2) Exclude variables with 0 covariance
# 3) Double check multicollinearity or correlation of 1 in latent factors and between brain indicators and reduce if necessary
# 4) check for residual covariance and account for it in model 
# 5) New model is above

'
factor_scores <- lavPredict(fit_edu)
cor.test(
  factor_scores[, "education"],
  factor_scores[, "cognition"],
  method = "pearson"
)

### Fixing Warnings, 
# removing cerebralwhitematter as it correlates to 1 ith left wm
# Scaling data

data_merged_scaled <- data_merged
imaging_vars <- c(
  "CEREBRUMTCV",
  "GM",
  "HIPPOCAMPUS",
  "WMH",
  "CEREBRALWHITEMATTER"
)
data_merged_scaled[imaging_vars] <- lapply(
  data_merged_scaled[imaging_vars],
  function(x) as.numeric(scale(x))
)
sapply(data_merged_scaled[imaging_vars], mean, na.rm = TRUE)
sapply(data_merged_scaled[imaging_vars], sd, na.rm = TRUE)

### check for negative variance
parameterEstimates(fit_edu) %>%
  filter(
    op == "~~",
    lhs == rhs,
    lhs %in% c("education", "cognition")
  ) %>%
  select(lhs, est, se, pvalue)


## Check which residual covariances to add

fitMeasures(
  fit_edu,
  c("cfi.robust", "tli.robust",
    "rmsea.robust", "srmr")
)


modindices(fit_edu) %>%
  dplyr::arrange(desc(mi)) %>%
  dplyr::select(lhs, op, rhs, mi, epc, sepc.all) %>%
  head(10)
'


