results <- psych::corr.test(
  df_plot,
  use = "pairwise",
  adjust = "none"
)

cor_matrix <- results$r
p_matrix <- results$p

corrplot(cor_matrix, method = "color", type = "upper", p.mat = p_matrix, sig.level = c(0.001, 0.01, 0.05), insig = "label_sig", pch.cex = 1.2, pch.col = "black", diag = F)
